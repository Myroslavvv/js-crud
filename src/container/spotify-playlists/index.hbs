{{! 
Це код container файлу для index сторінки, 
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
 }}

<main class="main">
	 <h1>Список плейлістів</h1>
    <a href="/">На головну</a>
    <ul>
        {{#each playlists}}
            <li>
                <a href="/spotify-playlist?id={{this.id}}">
                    {{this.name}}
                </a>
            </li>
        {{/each}}
    </ul>
</main>


