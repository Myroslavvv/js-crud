{{! 
Це код container файлу для index сторінки, 
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
 }}

<main class="main">
	{{#with data}}
  	<div class="main__content">
	    {{!-- <h1 class="title title--center">Плейліст 1</h1> --}}
	    <h1 class="title title--center">{{name}}</h1>

		<a href="/spotify-playlist-add?playlistId={{playlistId}}" class="add-button">
			<img width="70" height="70" src="/svg/plus7.svg">
			Додати до плейліста
		</a>

		<ul class="track__list">
			{{#each tracks}}
			<li class="track">
				<img src="{{image}}" alt="{{name}}">
				<div class="track__content">
					<strong class="track__name">{{name}}</strong>
					<em class="track__author">{{author}}</em>
				</div>
				<a href="/spotify-track-delete?playlistId={{../playlistId}}&trackId={{id}}">
					<img width="30" height="30" src="/svg/close4.svg">
				</a>
			</li>
			{{/each}}
		</ul>
  	</div>
	{{/with}}
</main>


{{! 
    Цей код містить лише те, що буде виводитись в <body>
    Адже наш layout/default.hbs має вже структуру HTML
}}