{{!    
Це код container файлу для index сторінки, 
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
 }}

<div class="form">
	<h1 class="form__title">Список товарів</h1>
	<form method="GET" action="/product-list">
  	<div class="form__product-list">
			{{#with data.products}}
				{{#if isEmpty}}
					<mark>Список товарів пустий</mark>
					{{else}}
					<ul>
						{{#each list}}
						<div class="form__content">
								{{!-- <div class="form__block">
									<div class="form__field">
										<label for="name" class="form__label">Назва товару</label>
										<input type="name" name="name" class="form__input"></label>
									</div>
									<div class="form__field">
										<label for="price" class="form__label">Ціна</label>
										<input type="price" name="price" class="form__input">
									</div>
								</div> --}}
									<li class="form__name">{{name}}</li>
									<li class="form__description">{{description}}</li>
									<li class="form__id">{{id}}</li>
									<li>
								<div class="form__block">
									<div class="form__field">
										<h3 class="form__price">{{price}}</h3>
									</div>
									<div class="form__field">
										<button class="form__edit"><a href="/product-edit?id={{id}}">Редагувати</a></button>
									</div>
								</div>
							</li>
							{{!-- <li>{{name}} | {{price}} | {{description}} | {{id}} <a href="/product-delete?id={{id}}">(Видалити)</a></li> --}}
						</div>
						{{/each}}
					</ul>
				{{/if}}
			{{/with}}
	</div>
	</form>
  	<a href="/">Повернутися назад</a>


	{{!-- <div class="form__content">
		<h2 class="form__name">Стильна сукня</h2>
		<h4 class="form__description">Опис сукня</h4>
		<h4 class="form__id">ID: 123</h4>
		<div class="form__block">
			<div class="form__field">
				<h3 class="form__price">Ціна 1500</h3>
			</div>
			<div class="form__field">
				<button class="form__edit">Редагувати</button>
			</div>
		</div>
	</div> --}}

</div>
 
