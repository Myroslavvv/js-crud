{{!    
Це код container файлу для index сторінки, 
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
 }}

<div class="form">
	<h1 class="form__title">Список товарів</h1>
	<form method="GET" action="/product-list">
  	<div class="form__product-list">
			{{#with data.products}}
				{{#if isEmpty}}
					<mark>Список товарів пустий</mark>
					{{else}}
					<ul>
						{{#each list}}
						<div class="form__content">
							<li class="form__name">{{name}}</li>
							<li class="form__description">{{description}}</li>
							<li class="form__id">{{id}}</li>
							<li>
								<div class="form__block">
									<div class="form__field">
										<h3 class="form__price">{{price}}</h3>
									</div>
									<div class="form__field">
										<button class="form__edit"><a href="/product-edit?id={{id}}">Редагувати</a></button>
									</div>
								</div>
							</li>
						</div>
						{{/each}}
					</ul>
				{{/if}}
			{{/with}}
	</div>
	</form>
  	<a href="/">Повернутися назад</a>
</div>
 
{{! 
    Цей код містить лише те, що буде виводитись в <body>
    Адже наш layout/default.hbs має вже структуру HTML
}}