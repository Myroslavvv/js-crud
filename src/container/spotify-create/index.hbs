{{! 
Це код container файлу для index сторінки, 
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
 }}

<main class="main">
  <div class="main__content">
	<header class="header">
		<a href="/">
			<img width="30" height="30" src="/svg/close4.svg" class="choose__image">
		</a>
	</header>
	<h1 class="title title__center">Назвіть плейліст</h1>

	<form method="POST" action="/spotify-create{{#if data.isMix}}?isMix=true{{/if}}" class="form">
		<input type="text" class="form__field" placeholder="Назва" name="name">
		<button class="form__button">Створити</button>
	</form>
  </div>
</main>


