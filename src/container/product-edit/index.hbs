{{!    
Це код container файлу для index сторінки, 
в якому міститься код, котрий буде віддаватися по шляху (PATH) - "/"
 }}

{{#with data.product}}

	<div class="form">
		<h1 class="form__title">Редагування товару</h1>
		<form method="POST" action="/product-edit">
			<div class="form__content">
			<h2 class="form__info">Інформація про товар</h2>
				<div class="form__block">
					<div class="form__field">
						<label for="name" class="form__label">Назва товару</label>
						<input type="name" name="name" value="{{name}}" class="form__input">
					</div>
					<div class="form__field">
						<label for="price" class="form__label">Ціна</label>
						<input type="price" name="price" value="{{price}}" class="form__input">
					</div>
					<div class="form__field">
						<label for="id" class="form__label">ID:</label>
						<input type="id" name="id" value="{{id}}" class="form__input">
					</div>
				</div>
				<div class="form__field">
					<label for="description" class="form__label">Короткий опис товару</label>
					<input type="description" name="description" value="{{description}}" class="form__input">
					<label for="overview" class="form__label">Відображується у картці товару</label>
				</div>
				<div class="form__block">
					<button type="submit" class="form__button-update">Зберегти оновлення</button>
					<button type="button" class="form__button-del" onclick="window.location.href='/product-delete?id={{id}}'">Видалити товар</button>
				</div>
			</div>
		</form>
		<a href="/">Повернутися назад</a>
	</div>
{{/with}}
 
{{! 
    Цей код містить лише те, що буде виводитись в <body>
    Адже наш layout/default.hbs має вже структуру HTML
}}